<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trung Thu Rực Rỡ - Gửi Mai Phương</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: radial-gradient(circle at center, #1b2735 0%, #090a0f 100%);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      color: #fff;
      text-align: center;
      padding: 20px;
      overflow: hidden;
      position: relative;
    }

    /* Mặt Trăng Rằm */
    .moon {
      position: absolute;
      top: 8%;
      width: 150px;
      height: 150px;
      background: radial-gradient(circle at 35% 35%, #fffdf0, #ffeaa7, #fdcb6e);
      border-radius: 50%;
      box-shadow: 0 0 50px rgba(255, 234, 167, 0.8), 0 0 100px rgba(255, 234, 167, 0.4);
      z-index: 1;
      animation: floatMoon 6s ease-in-out infinite alternate;
    }

    @keyframes floatMoon {
      0% { transform: translateY(0); }
      100% { transform: translateY(-10px); }
    }

    /* Hiệu ứng Mây qua trăng */
    .cloud {
      position: absolute;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 50px;
      z-index: 2;
      filter: blur(8px);
      animation: moveClouds 20s linear infinite;
    }
    .cloud-1 { top: 12%; left: -20%; width: 200px; height: 40px; }
    .cloud-2 { top: 18%; right: -25%; width: 250px; height: 50px; animation-duration: 25s; animation-delay: -5s; }

    @keyframes moveClouds {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(500%); }
    }

    /* Card hiển thị */
    .card {
      background: rgba(20, 25, 45, 0.75);
      backdrop-filter: blur(15px);
      border: 1px solid rgba(255, 215, 0, 0.3);
      border-radius: 24px;
      padding: 35px 25px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5), 0 0 20px rgba(255, 215, 0, 0.2);
      max-width: 400px;
      width: 100%;
      position: relative;
      z-index: 10;
      margin-top: 100px;
    }

    .title {
      font-size: 1.6rem;
      font-weight: 800;
      background: linear-gradient(45deg, #ffeaa7, #fdcb6e, #ff7675);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 10px;
      text-shadow: 0 2px 10px rgba(253, 203, 110, 0.3);
    }

    .subtitle {
      font-size: 1.1rem;
      color: #dfe6e9;
      margin-bottom: 25px;
    }

    /* Đèn Lồng Tương Tác */
    .lantern-container {
      position: relative;
      margin: 20px auto;
      width: 140px;
      height: 160px;
      cursor: pointer;
    }

    .lantern {
      width: 100px;
      height: 120px;
      background: linear-gradient(135deg, #ff4757, #ff6b81, #d63031);
      border-radius: 50px / 40px;
      margin: 0 auto;
      position: relative;
      box-shadow: 0 0 30px rgba(255, 71, 87, 0.8), inset 0 0 15px rgba(255, 234, 167, 0.6);
      animation: swing 3s ease-in-out infinite alternate;
      transform-origin: top center;
      transition: transform 0.3s ease;
    }

    .lantern:hover {
      transform: scale(1.08) rotate(2deg);
    }

    .lantern::before, .lantern::after {
      content: '';
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      background: #ffd700;
      width: 60px;
      height: 8px;
      border-radius: 4px;
    }
    .lantern::before { top: -4px; }
    .lantern::after { bottom: -4px; }

    .tassel {
      position: absolute;
      bottom: -30px;
      left: 50%;
      transform: translateX(-50%);
      width: 6px;
      height: 30px;
      background: #ffd700;
      box-shadow: 0 0 10px #ffd700;
    }

    @keyframes swing {
      0% { transform: rotate(-6deg); }
      100% { transform: rotate(6deg); }
    }

    .click-hint {
      font-size: 0.85rem;
      color: #ffeaa7;
      margin-top: 15px;
      animation: blink 1.5s infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    /* Popup Lời Chúc */
    .popup {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(8px);
      justify-content: center;
      align-items: center;
      z-index: 100;
    }

    .popup-content {
      background: linear-gradient(135deg, #1e272e, #2d3436);
      border: 2px solid #ffd700;
      padding: 30px 25px;
      border-radius: 20px;
      max-width: 340px;
      width: 90%;
      box-shadow: 0 10px 30px rgba(255, 215, 0, 0.3);
      position: relative;
      animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes popIn {
      0% { transform: scale(0.5); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    .popup-content h2 {
      font-size: 1.3rem;
      color: #ffd700;
      margin-bottom: 15px;
      line-height: 1.4;
    }

    .popup-content p {
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 20px;
      color: #f1f2f6;
      text-align: left;
    }

    .close-btn {
      background: linear-gradient(45deg, #ff4757, #ff6b81);
      color: white;
      border: none;
      padding: 10px 25px;
      border-radius: 25px;
      cursor: pointer;
      font-weight: bold;
      font-size: 0.95rem;
      box-shadow: 0 4px 15px rgba(255, 71, 87, 0.4);
      transition: all 0.2s ease;
    }

    .close-btn:active {
      transform: scale(0.95);
    }

    /* Nut Nhac */
    .music-btn {
      position: absolute;
      top: 20px;
      right: 20px;
      width: 40px;
      height: 40px;
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      z-index: 20;
      font-size: 1.2rem;
    }
  </style>
</head>
<body>

  <!-- Trăng & Mây -->
  <div class="moon"></div>
  <div class="cloud cloud-1"></div>
  <div class="cloud cloud-2"></div>

  <!-- Nút Bật/Tắt Nhạc -->
  <div class="music-btn" id="musicToggle">🎵</div>

  <!-- Nhạc Nền: Nơi Này Có Anh - Sơn Tùng M-TP -->
  <audio id="bgMusic" loop playsinline preload="auto">
    <source src="https://cdn.biihappy.com/zpro/music/noi-nay-co-anh.mp3" type="audio/mpeg">
  </audio>

  <!-- Khung Chính -->
  <div class="card">
    <div class="title">Đêm Hội Trăng Rằm 🌕</div>
    <div class="subtitle">Chúc Mừng Tết Trung Thu ❤️</div>

    <div class="lantern-container" id="lanternBtn">
      <div class="lantern">
        <div class="tassel"></div>
      </div>
    </div>

    <div class="click-hint">✨ Nhấp vào Lồng Đèn để mở quà ✨</div>
  </div>

  <!-- Popup Lời Chúc -->
  <div class="popup" id="popup">
    <div class="popup-content">
      <h2>Gửi Mai Phương – Chị Hằng Nga Đẹp Nhất Đêm Rằm 🌕💫</h2>
      <p>
        🥮 Chúc Mai Phương một mùa Trung Thu thật ngọt ngào, ấm áp và tràn ngập niềm vui!<br><br>
        ✨ Mong rằng cuộc sống của em sẽ luôn rực rỡ và tròn đầy như ánh trăng rằm đêm nay.<br><br>
        💖 Anh yêu em.!!😘
      </p>
      <button class="close-btn" onclick="closePopup()">Đóng lại</button>
    </div>
  </div>

  <script>
    const lanternBtn = document.getElementById('lanternBtn');
    const popup = document.getElementById('popup');
    const bgMusic = document.getElementById('bgMusic');
    const musicToggle = document.getElementById('musicToggle');
    let isPlaying = false;

    // Bật/Tắt nhạc khi nhấn nút
    musicToggle.addEventListener('click', () => {
      if (isPlaying) {
        bgMusic.pause();
        musicToggle.textContent = '🔇';
      } else {
        bgMusic.play();
        musicToggle.textContent = '🎵';
      }
      isPlaying = !isPlaying;
    });

    // Mở popup và tự động phát nhạc khi click Lồng Đèn
    lanternBtn.addEventListener('click', () => {
      popup.style.display = 'flex';
      if (!isPlaying) {
        bgMusic.play().then(() => {
          isPlaying = true;
          musicToggle.textContent = '🎵';
        }).catch(() => {});
      }
    });

    function closePopup() {
      popup.style.display = 'none';
    }
  </script>
</body>
</html>